{
  "name": "vue-internet-checker",
  "description": "Check internet availability in your Vue app",
  "version": "3.0.0",
  "author": {
    "name": "Harsh Mendapara",
    "email": "mendaparaharsh02@gmail.com",
    "url": "https://github.com/Harsh02051998"
  },
  "private": false,
  "main": "dist/vue-internet-checker.js",
  "module": "dist/vue-internet-checker.esm.js",
  "types": "index.d.ts",
  "unpkg": "dist/vue-internet-checker.min.js",
  "jsdelivr": "dist/vue-internet-checker.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/vue-internet-checker.esm.js",
      "require": "./dist/vue-internet-checker.js"
    }
  },
  "files": [
    "dist/*",
    "index.d.ts"
  ],
  "keywords": [
    "vue",
    "vue3",
    "online",
    "offline",
    "internet",
    "internet-checker",
    "connectivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshmendapara/vue-internet-checker"
  },
  "scripts": {
    "build": "npm run clean && npm run bundle && npm run bundle:min",
    "bundle": "rollup -c build/rollup.conf.js",
    "bundle:min": "rollup -c build/rollup.min.conf.js",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@vue/compiler-sfc": "^3.5.13",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.9",
    "rollup-plugin-vue": "^6.0.0",
    "vue": "^3.5.13"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harshmendapara/vue-internet-checker/issues"
  }
}
